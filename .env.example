# Salin file ini menjadi .env.local (lokal) atau isi di Vercel → Settings → Environment Variables

# Alamat website (dipakai untuk link di email)
NEXT_PUBLIC_SITE_URL=https://bludata-store.vercel.app

# ---------- Pembayaran ----------
# demo     = coba alur tanpa uang sungguhan (ada tombol "Simulasikan pembayaran")
# midtrans = pembayaran sungguhan (sandbox/production)
PAYMENT_PROVIDER=demo

# Dashboard Midtrans → Settings → Access Keys
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# false = sandbox (uji coba), true = production (uang sungguhan)
MIDTRANS_IS_PRODUCTION=false
# snap = halaman bayar Midtrans muncul di atas website (paling mudah, langsung bisa)
# core = QR & nomor VA tampil langsung di desain website (perlu minta aktivasi Core API ke Midtrans untuk production)
MIDTRANS_INTEGRATION=snap

# ---------- Database pesanan (Upstash Redis) ----------
# Otomatis terisi kalau Upstash disambungkan lewat Vercel Marketplace (nama KV_REST_API_URL / KV_REST_API_TOKEN juga dikenali)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Email otomatis (SMTP) ----------
# Gmail: aktifkan verifikasi 2 langkah → buat "App password" → isi di SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=emailkamu@gmail.com
SMTP_PASS=
EMAIL_FROM="BluData <emailkamu@gmail.com>"
EMAIL_REPLY_TO=
